<?xml version="1.0"?>
<!--
/**
 * Ebizmarts_MailChimp Magento Component
 *
 * Runs the unit suite from a checkout of this extension, without needing a
 * built Magento project. See Test/bootstrap.php for what that takes.
 *
 * @copyright   Ebizmarts (http://ebizmarts.com)
 * @license     http://opensource.org/licenses/osl-3.0.php  Open Software License (OSL 3.0)
 */
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="Test/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         failOnWarning="true"
         failOnNotice="true">
    <testsuites>
        <testsuite name="Ebizmarts_MailChimp unit">
            <directory>Test/Unit</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory suffix=".php">Block</directory>
            <directory suffix=".php">Cron</directory>
            <directory suffix=".php">Helper</directory>
            <directory suffix=".php">Model</directory>
            <directory suffix=".php">Observer</directory>
        </include>
    </source>
</phpunit>
